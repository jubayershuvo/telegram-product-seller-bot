# ---------- Core (secrets / bootstrap only) ----------
# Everything else (shop name, payment numbers, recharge limits...) lives in MongoDB
# and is changed by admins inside Telegram: /settings, /set, /resetsetting.
# Prices and order limits are NOT settings: each product has its own (/products).
# Defaults for those settings are defined in src/models/Setting.ts
NODE_ENV=production

# Token from @BotFather
BOT_TOKEN=123456789:replace_me_with_real_token
# Comma separated numeric Telegram user IDs of admins (get yours from @userinfobot)
ADMIN_IDS=123456789

# Local:  mongodb://127.0.0.1:27017/email_bot
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/email_bot
MONGODB_URI=mongodb://127.0.0.1:27017/email_bot

# Optional: public domain => webhook mode (put HTTPS reverse proxy in front of PORT).
# Leave empty for long polling (default, no domain needed).
WEBHOOK_DOMAIN=
PORT=3000
# Get from https://smssync-server.vercel.app/dashboard
SMSSYNC_API_KEY=