{
  "name": "telegram-shop-bot",
  "version": "1.0.0",
  "description": "Multi-product Telegram shop bot: per-product prices, wallet, bKash/Nagad recharge, Excel/CSV stock import, MongoDB",
  "main": "dist/index.js",
  "private": true,
  "engines": { "node": ">=18.18.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
